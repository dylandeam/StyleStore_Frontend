{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/assets/**", "/logo.jpg", "/*.(png|jpg|jpeg|svg|webp|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "catalog-images",
      "urls": [
        "/uploads/**",
        "https://web-production-07e73.up.railway.app/uploads/**",
        "https://stylestorebackend-production.up.railway.app/uploads/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 150,
        "maxAge": "3d"
      }
    }
  ]
}
